{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",

  "rewrites": [
    { "source": "/test-maker/:path*", "destination": "/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],

  "functions": {
    "api/**/*.ts": {
      "memory": 512,
      "maxDuration": 30
    }
  }
}
